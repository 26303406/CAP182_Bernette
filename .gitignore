# pyenv
#   For a library or package, you might want to ignore these files since the Python version is
#   managed by the end user. For a specific deployment, you might want to commit them.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in cases where the dependency version needs to be flexible, you can ignore it.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains exact versions. Include it in VCS if desired.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains exact versions. Include it in VCS if desired.
#pdm.lock

# PEP 582 project packages
__pypackages__/

